const ID_LENGTH = 6;                       // 000001
 
// Names of the objects in your .lbx template (set in P-touch Editor).
// If the QR does not change on the label, try "text_qr" instead of "barcode_qr".
const QR_PARAM = "barcode_qr";
const ID_PARAM = "text_id";                // set to null if the label has no ID text object
 
 
/* ================= ID COUNTER (replace nextId) ================= */
// Android: counter lives in SharedPreferences (survives clearing the web data).
// Browser fallback: localStorage.
function getNextId(list) {
    if (typeof Android !== "undefined" && Android.nextBadgeId) {
        const id = Android.nextBadgeId(ID_LENGTH);
        // keep localStorage in sync as a second copy
        try { localStorage.setItem("lastId", String(parseInt(id, 10))); } catch (e) {}
        return id;
    }
 
    let max = 0;
    try { max = parseInt(localStorage.getItem("lastId") || "0", 10) || 0; } catch (e) {}
    list.forEach(v => { const n = parseInt(v.id, 10); if (n > max) max = n; });
 
    const next = max + 1;
    try { localStorage.setItem("lastId", String(next)); } catch (e) {}   // <- this was missing before
    return pad(next);
}
 
 
/* ================= QR CONTENT ================= */
// Format must match parseQr(): ID; Name; Firma; E-Mail; Kontakt; Eintrittsdatum
function buildQrContent(v) {
    const entry = new Date(v.timestamp)
        .toLocaleString("de-DE", { dateStyle: "short", timeStyle: "short" })
        .replace(",", "");                     // 28.10.2026 14:30
 
    // semicolons / line breaks inside the data would break the format
    const clean = s => String(s).replace(/[;\r\n\t]+/g, " ").trim();
 
    return [v.id, v.vorname, v.firma, v.email, v.kontakt, entry].map(clean).join(";");
}
 
 
