function printBadge(visitor) {
    let url = "brotherwebprint://print" +
              "?filename=visitor_brother.lbx" +
              "&size=164x102bm.bin" +
              "&text_vorname=" + encodeURIComponent(visitor.vorname) +
              "&text_firma="   + encodeURIComponent(visitor.firma);
 
    if (ID_PARAM) url += "&" + ID_PARAM + "=" + encodeURIComponent(visitor.id);
    url += "&" + QR_PARAM + "=" + encodeURIComponent(buildQrContent(visitor));
 
    window.location.href = url;
}
 
